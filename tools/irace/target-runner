#!/usr/bin/env bash
# irace target-runner for parameter_control_heuristic.
#
# Arguments from irace:
#   $1  candidate configuration id
#   $2  instance id
#   $3  seed
#   $4  instance file path
#   $5+ parameter switches: --min_improvement X --top_percent Y
#
# Prints a single numeric cost (final objective; lower is better) to stdout.
set -euo pipefail

CONFIG_ID="${1:?}"
INSTANCE_ID="${2:?}"
SEED="${3:?}"
INSTANCE="${4:?}"
shift 4

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BIN="$ROOT/build/parameter_control_heuristic"
TIME_LIMIT=16

if [[ ! -x "$BIN" ]]; then
  echo "error: missing binary $BIN (run: make build/parameter_control_heuristic)" >&2
  exit 1
fi

MIN_IMPROVEMENT=0.01
TOP_PERCENT=50

while [[ $# -gt 0 ]]; do
  case "$1" in
    --min_improvement|-min_improvement)
      MIN_IMPROVEMENT="$2"
      shift 2
      ;;
    --top_percent|-top_percent)
      TOP_PERCENT="$2"
      shift 2
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 1
      ;;
  esac
done

WORKDIR="${TMPDIR:-/tmp}/irace_pch_${CONFIG_ID}_${INSTANCE_ID}_$$"
mkdir -p "$WORKDIR"
CSV="$WORKDIR/out.csv"
LOG="$WORKDIR/run.log"
trap 'rm -rf "$WORKDIR"' EXIT

# Solver is deterministic for these knobs; SEED is accepted for irace protocol.
cd "$ROOT"
set +e
"$BIN" "$MIN_IMPROVEMENT" "$TOP_PERCENT" "$TIME_LIMIT" 3 --save-csv "$INSTANCE" "$CSV" \
  >"$LOG" 2>&1
status=$?
set -e

if [[ $status -ne 0 ]]; then
  echo "error: solver failed (status=$status) for config=$CONFIG_ID instance=$INSTANCE_ID" >&2
  tail -n 40 "$LOG" >&2 || true
  exit $status
fi

COST="$(
  python3 - "$CSV" "$LOG" <<'PY'
import csv, re, sys
csv_path, log_path = sys.argv[1], sys.argv[2]
# Prefer the results CSV Final Objective column.
try:
    with open(csv_path, newline="") as handle:
        reader = csv.DictReader(handle)
        rows = list(reader)
    if rows and "Final Objective" in rows[0]:
        print(float(rows[0]["Final Objective"]))
        raise SystemExit(0)
except SystemExit:
    raise
except Exception:
    pass

text = open(log_path, errors="replace").read()
matches = re.findall(r"Final objective:\s*([0-9.+-eE]+)", text)
if not matches:
    raise SystemExit("could not parse final objective")
print(float(matches[-1]))
PY
)"

# irace requires exactly one numeric cost on stdout
printf '%s\n' "$COST"
